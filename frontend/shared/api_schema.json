{
  "baseUrl": "http://localhost:8000",
  "endpoints": [
    {
      "method": "GET",
      "path": "/products/search",
      "description": "Search for a product by name or paste a marketplace URL.",
      "query": {
        "q": "string — product name or a product URL (Amazon/eBay/Flipkart)"
      },
      "response": {
        "results": [
          {
            "id": "string",
            "title": "string",
            "image": "string (url)",
            "price": "number",
            "currency": "string, e.g. INR",
            "retailer": "string, e.g. Amazon"
          }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Full detail for a single product.",
      "response": {
        "id": "string",
        "title": "string",
        "image": "string (url)",
        "currentPrice": "number",
        "currency": "string",
        "retailer": "string",
        "url": "string",
        "specs": { "key": "value pairs, e.g. storage, color, model" }
      }
    },
    {
      "method": "GET",
      "path": "/products/{id}/forecast",
      "description": "30-day price forecast for a product, generated by the ai-engine.",
      "response": {
        "history": [
          { "date": "YYYY-MM-DD", "price": "number" }
        ],
        "forecast": [
          {
            "date": "YYYY-MM-DD",
            "predictedPrice": "number",
            "confidenceLow": "number",
            "confidenceHigh": "number"
          }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/products/{id}/deal-score",
      "description": "Deal Integrity Score (0-100) — how genuine the current discount is.",
      "response": {
        "score": "number, 0-100",
        "label": "string, e.g. Genuine Deal | Mediocre | Fake Discount",
        "reason": "string, human-readable explanation, e.g. 'Price is only 3% below its 90-day average'",
        "baseline30d": "number",
        "baseline60d": "number",
        "baseline90d": "number"
      }
    },
    {
      "method": "GET",
      "path": "/products/{id}/alternatives",
      "description": "Matching listings for the same product across other marketplaces, matched via LLM spec matching.",
      "response": {
        "alternatives": [
          {
            "retailer": "string",
            "url": "string",
            "price": "number",
            "currency": "string",
            "matchConfidence": "number, 0-1",
            "condition": "string, e.g. new | refurbished | used"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/alerts/subscribe",
      "description": "Subscribe to instant-messaging alerts for a product's price drops.",
      "body": {
        "productId": "string",
        "channel": "string, e.g. telegram | sms",
        "contact": "string, telegram chat id or phone number",
        "targetPrice": "number, optional — alert when price drops at/below this"
      },
      "response": {
        "subscribed": "boolean",
        "alertId": "string"
      }
    }
  ]
}
